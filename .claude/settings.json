{
  "permissions": {
    "allow": [
      "Read(**)",
      "Grep(**)",
      "Glob(**)",
      "Write(database/mysql/updates/update-*.sql)",
      "Edit(database/mysql/updates/update-*.sql)",
      "Bash(mysql -h db *)",
      "Bash(curl *)",
      "Bash(gh pr *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue comment *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(git status *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git push origin *)",
      "Bash(git push -u origin *)",
      "Read(//var/run/**)",
      "Bash(env)",
      "Bash(echo \"=== Tomcat running? ===\"; pgrep -af tomcat 2>/dev/null | head -3 || echo \"tomcat not running\"; echo; echo \"=== Deployed WAR ===\"; ls -la /usr/local/tomcat/webapps/ 2>/dev/null | head; echo; echo \"=== make script ===\"; head -40 /scripts/make 2>/dev/null; echo \"=== DB ===\"; pgrep -af mysqld 2>/dev/null | head -1 || echo \"no local mysqld \\(likely separate db container\\)\")",
      "Read(//scripts/**)",
      "Bash(python3 -c \"import sys,json; d=json.load\\(sys.stdin\\); print\\('Title:',d['title']\\); print\\('State:',d['state']\\); print\\('Labels:',[l['name'] for l in d['labels']]\\); print\\('Comments:',d['comments']\\); print\\('Created:',d['created_at']\\); print\\('---BODY---'\\); print\\(d['body']\\)\")",
      "Bash(python3 -c \"import sys,json; [print\\('---',c['user']['login'],c['created_at'],'---\\\\n',c['body'],'\\\\n'\\) for c in json.load\\(sys.stdin\\)]\")"
    ],
    "deny": [
      "Write(.git/**)",
      "Write(.github/**)",
      "Write(.github/workflows/**)",
      "Write(database/**)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm --recursive *)",
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin --force *)",
      "Bash(git push origin -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git filter-repo *)",
      "Bash(git filter-branch *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo fork *)"
    ],
    "ask": [
      "Edit(database/mysql/oscarinit*.sql)",
      "Edit(database/mysql/oscardata*.sql)",
      "Edit(database/mysql/icd*.sql)",
      "Edit(database/mysql/measurementMapData.sql)",
      "Write(database/mysql/oscarinit*.sql)",
      "Write(database/mysql/oscardata*.sql)",
      "Bash(gh pr close *)",
      "Bash(gh issue close *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue create *)",
      "Bash(gh label *)",
      "Bash(gh run rerun *)",
      "Bash(git reset --soft *)",
      "Bash(git reset --mixed *)",
      "Bash(git stash drop *)",
      "Bash(gh api -X PATCH repos/*/* *)",
      "Bash(gh api -X PUT repos/*/* *)",
      "Bash(gh api -X DELETE repos/*/* *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/inject-test-context.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/validate-sql-safety.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/validate-owasp-encoding.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "companyAnnouncements": [
    "⚠️  DEVCONTAINER ONLY: CARLOS development defaults grant extensive permissions optimized for isolated devcontainers. Do NOT use in shared or production environments. See CLAUDE.md for details."
  ]
}
